# 이 파일을 복사해 .env 로 만든 뒤 키를 채웁니다.
#   Windows:  copy .env.example .env
# .env 는 git 에 올리지 않습니다 (.gitignore 에 포함). 키를 소스코드에 직접 적지 않습니다 (NF3001).

# 공공데이터포털 인증키 (Decoding 키 권장). 인천 · 한국공항공사 API 모두 같은 키를 씁니다.
DATA_GO_KR_KEY=

# (선택) Google Maps 좌표 조회용. 비워 두면 지도 링크 방식으로 동작합니다.
GOOGLE_MAPS_API_KEY=

# SSAFY GMS 키 (질문 해석용 LLM). OpenAI 계정 키가 아닙니다. 비워 두면 규칙 기반 해석으로 동작합니다.
GMS_API_KEY=

# VERIFY_FAIL_TOOLS=get_airport_congestion